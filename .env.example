VOYAGEURS_BACKEND_URL=
VOYAGEURS_BASE_URL=
NEXT_PUBLIC_VOYAGEURS_BASE_URL=
# Still read if the VOYAGEURS_ names above are empty.
ACCESS_TOKEN_KEY=voyageurs_access_token
REFRESH_TOKEN_KEY=voyageurs_refresh_token
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Path /api/login/google. Register this on the Google OAuth client.
NEXT_PUBLIC_GOOGLE_REDIRECT_URIS=
# Development only. Used when no session cookie is present. Ignored outside development.
MASTER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Server-only (NOT NEXT_PUBLIC): proxied by /api/google/*. Restrict by API in Cloud Console.
GOOGLE_MAPS_API_KEY=